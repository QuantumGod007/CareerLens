# Copy to .env locally. Never commit the populated file.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
# Confirm the organization has no paid billing before using --confirm-free-plan.
# There is no automatic model or provider fallback.

# Local backend only. Database, artifacts and local session token stay under data/.
CAREERLENS_DATA_DIR=./data/backend
CAREERLENS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CAREERLENS_LEASE_SECONDS=15
CAREERLENS_HEARTBEAT_SECONDS=2
CAREERLENS_POLL_SECONDS=0.5
CAREERLENS_RETRY_SECONDS=5
